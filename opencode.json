{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "edge-browser": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--executablePath",
        "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe",
        "--headless=false",
        "--isolated",
        "--slim"
      ],
      "enabled": true,
      "timeout": 60000
    }
  },
  "permission": {
    "webfetch": "deny",
    "bash": {
      "*": "allow",
      "*chrome*": "deny",
      "*firefox*": "deny",
      "*brave*": "deny",
      "*chromium*": "deny",
      "*mcp*server*puppeteer*": "deny",
      "*mcp*server*playwright*": "deny",
      "*mcpbrowser*": "deny",
      "*playwright*": "deny"
    }
  },
  "tools": {
    "edge-browser*": true
  }
}
